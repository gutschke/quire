# Cloudflare Pages applies these headers to every response.  Tighten as the
# runtime feature set grows; for the phase-1 scaffold the policy is the
# minimum useful baseline.

# OAuth callback page (M6a, OP-017): the most security-critical static page
# in the deploy.  Per DEC-023, defenses target internet randos (zero attack
# surface) and accidental disclosure.  The callback page MUST:
#   - default-src 'none'   — refuse every resource not explicitly allowed.
#   - script-src 'self'    — only our own callback.js; no inline scripts.
#   - style-src 'self' 'unsafe-inline' — inline <style> in callback.html.
#     'unsafe-inline' tolerated ONLY for stylistic chrome; the page has no
#     interactive surface a CSS injection could weaponize.
#   - connect-src 'none'   — the page does no XHR / fetch.
#   - frame-ancestors 'none' — refuse to be embedded.
#   - form-action 'none'   — no <form> submission.
#   - base-uri 'none'      — disallow <base> tag.
# Path-specific rules in Cloudflare Pages override the global `/*` rule
# beneath them (Pages applies the FIRST matching rule per header name).
# Keep this stanza ABOVE the wildcard.
/auth/google/callback*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'none'; img-src 'none'; font-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin

# `/*` wildcard — applies to the main app pages.  Cloudflare Pages auto-
# injects the Web Analytics beacon (`https://static.cloudflareinsights.com/
# beacon.min.js`) into every page response when the project has Web
# Analytics enabled.  The strict `script-src 'self'` baseline blocks that
# beacon and logs a noisy CSP violation in every user's console — visible
# to anyone debugging an unrelated issue (it scared a playtester).  We
# allow the beacon explicitly: it's first-party (Cloudflare's own infra,
# same provider that serves the Pages deploy), narrowly scoped to one
# host, and load-bearing only for analytics.  The connect-src grant
# mirrors the script-src grant so the beacon's POST back to
# `https://cloudflareinsights.com` doesn't trip a second violation.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://raw.githubusercontent.com https://api.anthropic.com https://generativelanguage.googleapis.com https://cloudflareinsights.com https://*.peerjs.com wss://*.peerjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
