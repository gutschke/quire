# Cloudflare Pages applies these headers to every response.  Tighten as the
# runtime feature set grows; for the phase-1 scaffold the policy is the
# minimum useful baseline.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://raw.githubusercontent.com https://generativelanguage.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
