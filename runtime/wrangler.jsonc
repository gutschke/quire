// Cloudflare Pages / Workers deploy config for the Quire runtime.
//
// The runtime is a static SPA — no server-side Worker code.  The `assets`
// block tells Cloudflare to serve the built `dist/` directory and to fall
// back to index.html for unknown paths so client-side routing (the
// `?campaign=` URL parameter, future hash routes) works without 404s.
//
// compatibility_date pins the Workers runtime semantics; bump as needed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quire",
  "compatibility_date": "2026-05-20",

  // The canonical-origin trust anchor is play.quire.games (custom domain).
  // Disable the parallel *.workers.dev URL so there is exactly one origin
  // serving the runtime.  Preview URLs depend on workers_dev being enabled,
  // so they are off too — re-enable both later if branch previews become
  // useful for testing.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
