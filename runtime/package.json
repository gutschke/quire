{
  "name": "quire-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quire play-app runtime: the static browser bundle that hosts the play experience.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "drill": "vitest run src/persistence.restore-drill.test.ts src/persistence.firewall-fuzz.test.ts src/core/peer.restore-rebroadcast.test.ts src/core/state.firewall-fuzz.test.ts",
    "check-bundle": "node scripts/check-bundle-size.mjs",
    "lint-campaign-links": "node scripts/lint-campaign-links.mjs",
    "cors-probe": "node scripts/cors-probe-google-token.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "js-yaml": "^4.1.1",
    "lit": "^3.2.1",
    "marked": "^18.0.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@cloudflare/vite-plugin": "^1.37.2",
    "@playwright/test": "^1.60.0",
    "@roamhq/wrtc": "^0.10.0",
    "@types/dompurify": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "happy-dom": "^20.9.0",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gutschke/quire.git"
  },
  "license": "MIT"
}
